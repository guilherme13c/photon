    {
      "title": "Service latency p50",
      "description": "Processing latency by service instance. The photon_end_to_end series is measured from Fetcher/Renderer processing start through the successful Qdrant upsert.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, job, instance, __name__) (rate({__name__=~\"frontier_admission_duration_seconds_bucket|fetcher_process_duration_seconds_bucket|renderer_process_duration_seconds_bucket|extractor_process_duration_seconds_bucket|embedder_process_duration_seconds_bucket|photon_end_to_end_duration_seconds_bucket\"}[5m]))) * 1000",
          "legendFormat": "{{job}} {{instance}} · {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "title": "Pipeline Throughput by Service",
      "description": "Each series measures completed units per second for the named stage.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "expr": "sum by (job, instance) (rate(urls_ingested_total[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        },
        {
          "expr": "sum by (job, instance) (rate(fetcher_urls_processed_total{status=\"success\"}[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        },
        {
          "expr": "sum by (job, instance) (rate(renderer_pages_rendered_total{status=\"success\"}[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        },
        {
          "expr": "sum by (job, instance) (rate(html_processed_total[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        },
        {
          "expr": "sum by (job, instance) (rate(embedder_messages_processed_total{status=\"success\"}[5m]))",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
